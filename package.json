{
  "name": "sql-tools",
  "description": "olap for sql non-olap engines / and other tools",
  "version": "0.2.2",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codenautas/sql-tools.git"
  },
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "main": "bin/sql-tools.js",
  "dependencies": {
    "type-store": "^0.6.5"
  },
  "devDependencies": {
    "best-globals": "^2.2.3",
    "c8": "^12.0.0",
    "expect.js": "^0.3.1",
    "mini-tools": "^1.13.14",
    "mocha": "^12.0.3",
    "pg-promise-strict": "^1.6.0",
    "qa-control": "^0.14.2"
  },
  "engines": {
    "node": ">= 0.8.0"
  },
  "scripts": {
    "test": "mocha --reporter spec --bail --check-leaks --globals json4allRegisteredTypes test/",
    "test-ci": "c8 --reporter=lcov mocha --reporter spec --check-leaks --globals json4allRegisteredTypes test/",
    "test-cov": "c8 mocha --reporter dot --check-leaks --globals json4allRegisteredTypes test/"
  },
  "files": [
    "bin/sql-tools.js",
    "index.d.ts"
  ],
  "qa-control": {
    "run-in": "server",
    "type": "lib",
    "coverage": 90,
    "gha": {
      "postgres": "lts"
    },
    "fileNameMainDoc": "README.md",
    "sonar": true
  }
}
